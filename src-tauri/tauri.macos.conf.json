{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"windows": [
			{
				"title": "Cockpit",
				"width": 1480,
				"height": 940,
				"minWidth": 1080,
				"minHeight": 680,
				"titleBarStyle": "Overlay",
				"acceptFirstMouse": true,
				"hiddenTitle": true,
				"backgroundColor": "#eceff2",
				"theme": "Dark",
				"center": true
			}
		]
	},
	"bundle": {
		"targets": [
			"app",
			"dmg"
		],
		"icon": [
			"icons/icon.icns"
		],
		"macOS": {
			"minimumSystemVersion": "13.0",
			"entitlements": "Entitlements.plist"
		}
	}
}
